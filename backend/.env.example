# Conexão com o PostgreSQL (o docker-compose sobe um em localhost:5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leilao
# Defina "true" se o provedor exigir SSL (ex.: URL externa do Render/Neon)
DATABASE_SSL=false

PORT=3333

# Segredos: em produção são obrigatórios. Use valores longos e aleatórios.
JWT_SECRET=troque-este-segredo
# Semente da chave Ed25519 que assina o histórico de lances (NÃO fica no banco)
LEDGER_SIGNING_SECRET=troque-este-segredo-do-ledger
# Segredo usado para gerar os pseudônimos dos licitantes (privacidade)
PSEUDONYM_SECRET=troque-este-segredo-de-pseudonimos

# Popula o banco com dados de demonstração no boot se ele estiver vazio
SEED_ON_BOOT=true
